# Copy to .env. Keep source-account credentials in Antennarr, not here.
ANTENNARR_IMAGE=antennarr:local
ANTENNARR_DATA_DIR=./data
# Local administration by default. Set this to the server LAN IP for LAN access.
ANTENNARR_BIND=127.0.0.1
ANTENNARR_ADMIN_PORT=39192
ANTENNARR_TUNER_PORT=9192
# Must be reachable from Plex. Use the server's LAN IP for separate hosts.
ANTENNARR_BASE_URL=http://127.0.0.1:9192
# Optional existing-network overlay: compose.network.yaml
PLEX_NETWORK=plex_network
PUID=10001
PGID=10001
ANTENNARR_TRUSTED_PROXIES=
